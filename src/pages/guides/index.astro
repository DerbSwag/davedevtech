---
import BaseLayout from '../../layouts/BaseLayout.astro'; import GuideCard from '../../components/GuideCard.astro'; import { getSortedGuides } from '../../lib/guides';
const guides = await getSortedGuides();
---
<BaseLayout title="Tech Guides คู่มือไอทีและอุปกรณ์ | DaveDev Tech" description="คู่มือเลือกซื้ออุปกรณ์คอมพิวเตอร์ Home Lab, SSD และระบบเครือข่าย อ่านเข้าใจง่าย ใช้งานได้จริง"><section class="page-hero compact"><p class="eyebrow">TECH GUIDES</p><h1>คู่มือไอที เลือกให้เหมาะ ใช้ให้คุ้ม</h1><p class="hero-description">คำแนะนำด้าน PC, Home Lab, Network และเทคโนโลยีที่ผ่านการคิดจากการใช้งานจริง</p></section><section class="section"><div class="card-grid">{guides.map(g=><GuideCard title={g.data.title} description={g.data.description} category={g.data.category} readTime={g.data.readTime} href={`/guides/${g.id}`} />)}</div></section></BaseLayout>
