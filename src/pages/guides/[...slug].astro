---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection, render } from 'astro:content'; import AffiliateButton from '../../components/AffiliateButton.astro';
export async function getStaticPaths(){ return (await getCollection('guides')).map(entry=>({params:{slug:entry.id},props:{entry}})); }
const {entry}=Astro.props; const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} | DaveDev Tech`} description={entry.data.description} ogType="article"><article class="article"><a class="back-link" href="/guides">← บทความทั้งหมด</a><header class="article-header"><div class="guide-meta"><span>{entry.data.category}</span><span>{entry.data.readTime} · {entry.data.pubDate.toLocaleDateString('th-TH',{year:'numeric',month:'long',day:'numeric'})}</span></div><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p></header><div class="prose"><Content components={{AffiliateButton}} /></div></article></BaseLayout>
