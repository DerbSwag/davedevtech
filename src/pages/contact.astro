---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const email = 'davedevtech@gmail.com';
const subject = encodeURIComponent('ปรึกษางาน IT — DaveDev Tech');
const body = encodeURIComponent('ประเภทงาน/ปัญหา:\nอุปกรณ์หรือระบบที่เกี่ยวข้อง:\nอาการและสิ่งที่ลองทำแล้ว:\nพื้นที่ให้บริการ/ช่วงเวลาที่สะดวก:\n');
---
<BaseLayout title="ปรึกษางาน IT กับ DaveDev Tech" description="ติดต่อ DaveDev Tech เพื่อปรึกษา IT Support, Network & Wi-Fi, Workflow Automation หรือ Infrastructure">
  <section class="page-hero compact">
    <p class="eyebrow">ติดต่อ DaveDev Tech</p>
    <h1>เล่าปัญหาหรืองานที่อยากปรับได้เลย</h1>
    <p class="hero-description">บอกอาการและผลกระทบที่เกิดขึ้น เราจะเริ่มจากทำความเข้าใจโจทย์ก่อนเสนอแนวทาง</p>
  </section>
  <section class="section contact-layout">
    <div class="contact-primary">
      <span class="contact-icon"><Icon name="email" /></span>
      <p class="eyebrow">ช่องทางติดต่อ</p>
      <h2>เลือกช่องทางที่สะดวก</h2>
      <p>โทรปรึกษาได้โดยตรง หรือส่งอีเมลที่เปิดพร้อมหัวข้อและรายการข้อมูลแนะนำ คุณแก้ไขข้อความและแนบรูปอาการได้ก่อนส่ง</p>
      <div class="contact-actions">
        <a class="button button-primary" href="tel:0822059652">โทรปรึกษาปัญหา</a>
        <a class="button button-outline" href={`mailto:${email}?subject=${subject}&body=${body}`}>เขียนอีเมลปรึกษา <span aria-hidden="true">↗</span></a>
      </div>
      <a class="contact-email" href={`mailto:${email}`}>{email}</a>
    </div>
    <aside class="contact-checklist">
      <h2>ข้อมูลที่ช่วยให้ประเมินได้เร็วขึ้น</h2>
      <ul>
        <li>ประเภทงาน เช่น IT Support, Network &amp; Wi-Fi, Workflow Automation หรือ Infrastructure</li>
        <li>รุ่นอุปกรณ์ โปรแกรม หรือแหล่งข้อมูลที่เกี่ยวข้อง</li>
        <li>อาการที่พบและเริ่มเกิดเมื่อไร</li>
        <li>สิ่งที่ลองแก้ไขไปแล้ว (ถ้ามี)</li>
        <li>พื้นที่และช่วงเวลาที่สะดวก หากต้อง On-site</li>
      </ul>
      <p class="privacy-note">ก่อนแนบภาพหน้าจอหรือไฟล์ โปรดลบ password, ข้อมูลส่วนบุคคล และข้อมูลธุรกิจที่ไม่เกี่ยวข้อง</p>
    </aside>
  </section>
  <section class="contact-location" aria-label="พื้นที่ให้บริการ"><strong>พื้นที่ให้บริการ</strong><span>ชลบุรี · Remote support ตามลักษณะงาน</span></section>
</BaseLayout>

<style>
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .contact-actions .button {
    min-height: 48px;
  }

  @media (max-width: 700px) {
    .contact-actions {
      flex-direction: column;
    }

    .contact-actions .button {
      width: 100%;
    }
  }
</style>
