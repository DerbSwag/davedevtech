---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import ServiceCard from '../components/ServiceCard.astro'; import GuideCard from '../components/GuideCard.astro'; import CTA from '../components/CTA.astro'; import { getSortedGuides } from '../lib/guides';
const guides = (await getSortedGuides()).slice(0,3);
---
<BaseLayout title="DaveDev Tech — IT Support, Automation & Tech Solutions" description="บริการ IT Support, ดูแลระบบคอมพิวเตอร์และเครือข่าย พร้อมปรับ Workflow ด้วย Automation สำหรับธุรกิจไทย"><Hero title="DaveDev Tech — IT Support, Automation & Tech Solutions" description="ดูแลระบบไอทีให้พร้อมใช้งาน พร้อมปรับ Workflow ลดงานซ้ำ เพื่อให้ทีมของคุณทำงานได้เต็มศักยภาพ"><a class="button button-primary" href="/services">ดูบริการ <span>↗</span></a><a class="button button-outline" href="/contact">ติดต่อปรึกษา</a></Hero><section class="section"><div class="section-heading"><div><p class="eyebrow">WHAT WE DO</p><h2>เทคโนโลยีที่ช่วยให้งานเดินหน้า</h2></div><a class="text-link" href="/services">บริการทั้งหมด ↗</a></div><div class="card-grid"><ServiceCard icon="⌘" title="IT Support" description="แก้ปัญหาคอมพิวเตอร์ ดูแลระบบและอุปกรณ์ ให้ทีมทำงานต่อได้ไม่สะดุด" href="/services/it-support" /><ServiceCard icon="↗" title="Automation" description="ลดงานซ้ำซ้อนและปรับ Workflow ให้ทีมทำงานได้เร็วขึ้น ด้วยระบบที่เหมาะกับงานจริง" href="/services/automation" /><ServiceCard icon="⌁" title="Network & Infrastructure" description="วางระบบเครือข่ายและโครงสร้างพื้นฐาน ให้เสถียร ปลอดภัย และพร้อมเติบโต" href="/services" /></div></section><section class="section section-muted"><div class="section-heading"><div><p class="eyebrow">FIELD NOTES</p><h2>คู่มือและคำแนะนำด้านเทคโนโลยี</h2></div><a class="text-link" href="/guides">อ่านทุกบทความ ↗</a></div><div class="card-grid">{guides.map(g=><GuideCard title={g.data.title} description={g.data.description} category={g.data.category} readTime={g.data.readTime} href={`/guides/${g.id}`} />)}</div></section><CTA /></BaseLayout>
