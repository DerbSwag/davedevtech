---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <a class="brand" href="/" aria-label="DaveDev Tech หน้าแรก" aria-current={currentPath === '/' ? 'page' : undefined}><span class="brand-mark">D</span><span>DaveDev <b>Tech</b></span></a>
  <nav class="desktop-nav" aria-label="เมนูหลัก">
    <a href="/services" aria-current={currentPath === '/services' ? 'page' : undefined}>บริการ</a><a href="/#work">ผลงาน</a><a href="/guides" aria-current={currentPath === '/guides' ? 'page' : undefined}>บทความ</a><a href="/#about">เกี่ยวกับเรา</a><a href="/contact" class="nav-cta" aria-current={currentPath === '/contact' ? 'page' : undefined}>ปรึกษางาน</a>
  </nav>
  <details class="mobile-nav">
    <summary><span class="menu-label-closed">เมนู</span><span class="menu-label-open">ปิดเมนู</span><span class="menu-icon-closed" aria-hidden="true">☰</span><span class="menu-icon-open" aria-hidden="true">×</span></summary>
    <nav id="mobile-menu" aria-label="เมนูมือถือ">
      <a href="/services" aria-current={currentPath === '/services' ? 'page' : undefined}>บริการ</a><a href="/#work">ผลงาน</a><a href="/guides" aria-current={currentPath === '/guides' ? 'page' : undefined}>บทความ</a><a href="/#about">เกี่ยวกับเรา</a><a href="/contact" class="mobile-nav-cta" aria-current={currentPath === '/contact' ? 'page' : undefined}>ปรึกษางาน</a>
    </nav>
  </details>
</header>
<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  if (mobileMenu) {
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !mobileMenu.open) return;
      const focusWasInMenu = mobileMenu.contains(document.activeElement);
      mobileMenu.open = false;
      if (focusWasInMenu) mobileMenu.querySelector('summary')?.focus();
    });
    mobileMenu.querySelectorAll('nav a').forEach((link) => {
      link.addEventListener('click', () => { mobileMenu.open = false; });
    });
    window.matchMedia('(min-width: 841px)').addEventListener('change', (event) => {
      if (event.matches) mobileMenu.open = false;
    });
  }
</script>
