---
interface Props { title?: string; description?: string; }
const { title = 'มีงานที่อยากทำให้เป็นระบบขึ้นไหม?', description = 'เล่าโจทย์ของคุณให้เราฟัง เรายินดีช่วยหาวิธีที่เหมาะกับทีมและงบประมาณ' } = Astro.props;
---
<section class="cta-band"><div><p class="eyebrow">LET’S MAKE IT WORK</p><h2>{title}</h2><p>{description}</p></div><a class="button button-light" href="/contact">ติดต่อปรึกษา <span aria-hidden="true">↗</span></a></section>
