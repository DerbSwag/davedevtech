---
interface Props { title?: string; description?: string; }
const { title = 'มีงาน IT ที่อยากให้ช่วยดูไหม?', description = 'เริ่มจากเล่าอาการหรือขั้นตอนที่อยากปรับ แล้วค่อยประเมินแนวทางและขอบเขตงานร่วมกัน' } = Astro.props;
---
<section class="cta-band"><div><p class="eyebrow">เริ่มจากการพูดคุย</p><h2>{title}</h2><p>{description}</p></div><a class="button button-light" href="/contact">ปรึกษางาน <span aria-hidden="true">↗</span></a></section>
