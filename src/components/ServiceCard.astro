---
interface Props { icon: string; title: string; description: string; href: string; }
const { icon, title, description, href } = Astro.props;
---
<a class="service-card" href={href}><span class="service-icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{description}</p><span class="text-link">ดูรายละเอียด <span aria-hidden="true">↗</span></span></a>
