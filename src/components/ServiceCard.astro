---
import Icon from './Icon.astro';
interface Props { icon: 'monitor' | 'network' | 'workflow' | 'server'; title: string; description: string; details: string; href: string; headingLevel?: 2 | 3; }
const { icon, title, description, details, href, headingLevel = 3 } = Astro.props;
---
<a class="service-card" href={href}><span class="service-icon"><Icon name={icon} /></span>{headingLevel === 2 ? <h2>{title}</h2> : <h3>{title}</h3>}<p>{description}</p><span class="service-detail">{details}</span><span class="text-link">ดูบริการนี้ <span aria-hidden="true">↗</span></span></a>
