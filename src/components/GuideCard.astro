---
interface Props { title: string; description: string; category: string; readTime: string; href: string; headingLevel?: 2 | 3; }
const { title, description, category, readTime, href, headingLevel = 3 } = Astro.props;
---
<a class="guide-card" href={href}><div class="guide-meta"><span>{category}</span><span>{readTime}</span></div>{headingLevel === 2 ? <h2>{title}</h2> : <h3>{title}</h3>}<p>{description}</p><span class="text-link">อ่านบทความ <span aria-hidden="true">↗</span></span></a>
