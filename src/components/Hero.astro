---
interface Props { eyebrow?: string; title: string; description: string; }
const { eyebrow = 'TECHNOLOGY THAT WORKS FOR YOU', title, description } = Astro.props;
---
<section class="hero"><div class="hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="hero-description">{description}</p><slot /></div><div class="hero-visual" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="chip"><span>DD</span><i>TECH / TH</i></div><span class="visual-label label-top">SYSTEMS · SUPPORT</span><span class="visual-label label-bottom">AUTOMATE THE EVERYDAY</span></div></section>
