---
import { caseStudies } from '../lib/case-studies';
---
<section class="work-section" id="work" aria-labelledby="work-title">
  <div class="work-inner">
    <div class="work-heading">
      <p class="eyebrow">PROOF OF WORK</p>
      <h2 id="work-title">วิธีทำงานที่ดูได้จากโจทย์จริง</h2>
      <p>เล่าปัญหาและวิธีทำงานโดยไม่เปิดเผยข้อมูลขององค์กรหรือระบบภายใน</p>
    </div>

    <div class="case-grid">
      {caseStudies.map((caseStudy) => (
        <article class="case-card">
          <p class="case-kicker">{caseStudy.kicker}</p>
          <h3>{caseStudy.title}</h3>
          <p>{caseStudy.description}</p>
          <ol class="case-steps">
            {caseStudy.steps.map((step) => <li><strong>{step.label}</strong><span>{step.description}</span></li>)}
          </ol>
          {'source' in caseStudy && <a class="case-source" href={caseStudy.source.href} target="_blank" rel="noopener noreferrer">{caseStudy.source.label} <span aria-hidden="true">↗</span></a>}
        </article>
      ))}
    </div>
  </div>
</section>
