---
const projects = [
  { name: 'factory_demo', type: 'Demo · Python desktop', title: 'เครื่องมือรายงานข้อมูลเวลาทำงาน', description: 'ตัวอย่าง Dashboard ที่กรองข้อมูลตามแผนกและส่งออก Excel ได้ แสดงแนวทางทำเครื่องมือให้ผู้ใช้งานจัดการรายงานได้สะดวกขึ้น', service: 'automation', link: 'ดูบริการ Automation' },
  { name: 'cctv-storage-expansion-truenas-iscsi', type: 'Portfolio · Infrastructure', title: 'ขยายพื้นที่จัดเก็บสำหรับระบบ CCTV', description: 'โปรเจกต์ Portfolio ด้าน Storage ด้วย TrueNAS, Hyper-V, ZFS และ iSCSI พร้อมการเชื่อมเครือข่ายผ่าน FortiGate', service: 'infrastructure', link: 'ดูบริการ Server และ Storage' },
  { name: 'proxmox-k8s-infra', type: 'Lab · Infrastructure & Monitoring', title: 'Lab ระบบ VM และการเฝ้าดูสถานะ', description: 'Lab ที่รวม Proxmox, Kubernetes, GitOps และ Monitoring พร้อมเอกสาร Incident และแผนกู้คืนระบบ สำหรับแสดงแนวทางออกแบบและเรียนรู้', service: 'infrastructure', link: 'ดูบริการ Backup และ Monitoring' },
];
---
<section class="work-section" id="work" aria-labelledby="work-title">
  <div class="work-inner">
    <div class="work-heading"><p class="eyebrow">ผลงานสาธารณะ</p><h2 id="work-title">ดูตัวอย่างเครื่องมือ<br />และแนวทางดูแลระบบ</h2><p>โปรเจกต์ Demo, Portfolio และ Lab ที่เปิดดูรายละเอียดได้ เพื่อประกอบการพูดคุยถึงโจทย์งานของคุณ</p></div>
    <div class="project-grid">{projects.map(project => <article class="project-card">
      <p class="project-type">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p>
      <a class="project-source" href={`https://github.com/DerbSwag/${project.name}`}>ดูโปรเจกต์บน GitHub <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={`/services/${project.service}`}>{project.link}</a>
    </article>)}</div>
  </div>
</section>
