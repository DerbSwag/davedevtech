---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonical?: string | false; noindex?: boolean; ogType?: 'website' | 'article'; localBusiness?: boolean; }
const { title, description, canonical, noindex = false, ogType = 'website', localBusiness = false } = Astro.props;
const canonicalUrl = canonical === false ? undefined : canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---
<!doctype html><html lang="th"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="generator" content={Astro.generator} /><title>{title}</title><meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, follow" />}{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}<meta property="og:type" content={ogType} /><meta property="og:locale" content="th_TH" /><meta property="og:site_name" content="DaveDev Tech" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}<meta property="og:image" content={new URL('/og-image.png', Astro.site)} /><meta property="og:image:alt" content="DaveDev Tech — IT Support, Automation & Tech Solutions" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} /><meta name="theme-color" content="#f7f8fa" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{localBusiness && <LocalBusinessJsonLd />}</head><body><a class="skip-link" href="#main-content">ข้ามไปยังเนื้อหาหลัก</a><Header /><main id="main-content"><slot /></main><Footer />{analyticsToken && <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}</body></html>
